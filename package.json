{
  "name": "download-release-action",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "GitHub action to update download releases",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DataDog/download-release-action.git"
  },
  "keywords": [
    "actions",
    "releases"
  ],
  "author": "Bruce Bujon",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jest": "^29.0.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^17.6.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.0"
  },
  "bugs": {
    "url": "https://github.com/DataDog/download-release-action/issues"
  },
  "homepage": "https://github.com/DataDog/download-release-action#readme"
}
